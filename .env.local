# Este archivo se commitea: NUNCA pongas valores reales aquí.
# Copia a .env.local y pon ahí tus claves (ese archivo está en .gitignore).

# --- IA (OpenAI) ---
OPENAI_API_KEY= key_O9XEefZN4yQ9btVg
# El "smart" extrae y evalúa; el "fast" interpreta a los estudiantes simulados.
OPENAI_MODEL_SMART=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
# Opcional: apuntar a un proxy compatible con la API de OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Supabase (opcional: sin esto la app usa un store en memoria) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Demo ---
# true = las rutas /api responden con los fixtures de /fixtures (fallback del jurado)
DEMO_MODE=false
