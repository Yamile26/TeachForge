# --- IA (Gemini / Google AI Studio) ---
GEMINI_API_KEY=
# Alias "latest" siguen al modelo vigente; puedes fijar una versión concreta.
GEMINI_MODEL_SMART=gemini-pro-latest
GEMINI_MODEL_FAST=gemini-flash-latest

# --- Supabase (opcional por ahora: sin esto la app usa un store en memoria) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Demo ---
# true = las rutas /api responden con los fixtures de /fixtures (fallback del jurado)
DEMO_MODE=false
